<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:finwise.maui.ViewModels"
             x:Class="finwise.maui.Views.MainPage"
             x:DataType="vm:MainViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="45,*" ColumnDefinitions="*,50">
        <BoxView Grid.Row="0" Grid.ColumnSpan="2" Color="{AppThemeBinding Light={StaticResource LightNavBar}, Dark={StaticResource DarkNavBar}}"/>

        <Label Grid.Row="0" Grid.Column="0" Padding="10,0" VerticalTextAlignment="Center" Text="{Binding Title}" FontSize="20"
               SemanticProperties.HeadingLevel="Level1" />
        <Button Grid.Row="0" Grid.Column="1" Padding="10,0"
                BackgroundColor="{AppThemeBinding Light={StaticResource LightNavBar}, Dark={StaticResource DarkNavBar}}"
                ImageSource="{AppThemeBinding Light=search.png,Dark=search_dark.png}"
                SemanticProperties.Description="Search"
                Command="{Binding OpenSearchCommand}"/>

        <ScrollView Padding="10" Grid.Row="1" Grid.ColumnSpan="2" BackgroundColor="{AppThemeBinding Light={StaticResource LightBG}, Dark={StaticResource DarkBG}}">
            <VerticalStackLayout>
                <Grid RowDefinitions="165,100,auto" ColumnDefinitions="*">
                    <!-- Placeholder: balance card -->
                    <BoxView CornerRadius="5" Grid.Row="0" Color="{AppThemeBinding Light={StaticResource LightNavBar}, Dark={StaticResource DarkNavBar}}"/>
                    <!-- Placeholder: budget card -->
                    <BoxView Margin="0,8" CornerRadius="5" Grid.Row="1" Color="{AppThemeBinding Light={StaticResource LightNavBar}, Dark={StaticResource DarkNavBar}}"/>
                    <FlexLayout JustifyContent="SpaceBetween" Margin="5,10" Grid.Row="2">
                        <Label Text="Recent Activity" VerticalTextAlignment="Center" SemanticProperties.HeadingLevel="Level2" />
                        <Button BackgroundColor="{AppThemeBinding Light={StaticResource LightBG}, Dark={StaticResource DarkBG}}"
                                Text="View All" Command="{Binding OpenSearchCommand}"/>
                    </FlexLayout>
                </Grid>
                <!-- Placeholder: recent activity list -->
                <Label Text="No activity yet." />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
